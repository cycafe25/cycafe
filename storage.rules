rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // A profile photo belongs to, and can be read or replaced only by, its owner.
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Customer PAN application files are private to the operator account.
    // Full Aadhaar numbers, OTPs, payment credentials, and executables are not accepted.
    match /users/{userId}/pan-applications/{applicationId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf)');
    }
  }
}
